APP_ENV=local            # local | demo | public
AWS_REGION=us-east-1
AWS_PROFILE=             # local demo only
BEDROCK_MODEL_ID=        # copy from Bedrock console
LLM_PROVIDER=bedrock     # bedrock | groq | gemini | template
GROQ_API_KEY=            # optional
GROQ_MODEL_ID=           # optional; copy the current id from the Groq console
GEMINI_API_KEY=          # optional
CORS_ORIGINS=http://localhost:5173
ENGINE_SEED=42
ENGINE_DRAWS=8192
# Local default: .runtime/feedback.sqlite3 (ignored by Git).
# Public hosting: set this to a path on a persistent mounted disk; otherwise
# live analysis works but case feedback/history cannot be saved.
FEEDBACK_DB_PATH=
