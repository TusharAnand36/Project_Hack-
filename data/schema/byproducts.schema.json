        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "role": {
          "enum": [
            "core",
            "control",
            "stretch"
          ],
          "title": "Role",
          "type": "string"
        },
        "allergen": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Allergen"
        },
        "oil_routes": {
          "items": {
            "type": "string"
          },
          "title": "Oil Routes",
          "type": "array"
        },
        "gates": {
          "items": {
            "type": "string"
          },
          "title": "Gates",
          "type": "array"
        },
        "composition": {
          "additionalProperties": {
            "$ref": "#/$defs/Param"
          },
          "title": "Composition",
          "type": "object"
        },
        "compounds": {
          "additionalProperties": {
            "$ref": "#/$defs/Param"
          },
          "title": "Compounds",
          "type": "object"
        },
        "flavour_baseline": {
          "additionalProperties": {
            "$ref": "#/$defs/Param"
          },
