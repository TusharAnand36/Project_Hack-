          "title": "Id",
          "type": "string"
        },
        "citation": {
          "title": "Citation",
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        },
        "doi": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Doi"
        },
        "kind": {
          "enum": [
            "peer_reviewed",
            "review",
            "patent",
            "trade",
            "regulatory",
            "user_draft",
            "web",
            "plan"
          ],
          "title": "Kind",
          "type": "string"
        },
        "accessed": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Accessed"
