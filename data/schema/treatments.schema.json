        "first_for": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": "First For",
          "type": "object"
        },
        "before": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "string"
              },
              {
                "type": "string"
              }
            ],
            "type": "array"
          },
          "title": "Before",
          "type": "array"
        },
        "forbidden_sequences": {
          "items": {
            "maxItems": 2,
