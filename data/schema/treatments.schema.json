        },
        "extraction_route": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Extraction Route"
        },
        "source_location": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Location"
        }
      },
      "required": [
        "unit",
        "tag"
      ],
      "title": "Param",
      "type": "object"
    },
    "Precedence": {
      "additionalProperties": false,
      "description": "Ordering rules from source plan \u00a712.4.",
      "properties": {
        "max_length": {
