            "prefixItems": [
              {
                "type": "string"
              },
              {
                "type": "string"
              }
            ],
            "type": "array"
          },
          "title": "Mutually Exclusive",
          "type": "array"
        },
        "max_fractionation": {
          "title": "Max Fractionation",
          "type": "integer"
        },
        "after_fractionation_allowed": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": "After Fractionation Allowed",
          "type": "object"
        },
        "not_between": {
          "items": {
            "maxItems": 3,
            "minItems": 3,
            "prefixItems": [
              {
                "type": "string"
              },
              {
                "type": "string"
              },
              {
                "type": "string"
              }
            ],
            "type": "array"
          },
          "title": "Not Between",
          "type": "array"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        }
      },
      "required": [
        "max_length",
        "first_for",
        "before",
        "forbidden_sequences",
        "mutually_exclusive",
        "max_fractionation",
        "after_fractionation_allowed",
        "not_between"
