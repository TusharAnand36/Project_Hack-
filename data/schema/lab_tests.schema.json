{
  "$defs": {
    "Dist": {
      "additionalProperties": false,
      "description": "A probability distribution described by low / mode / high.",
      "properties": {
        "type": {
          "enum": [
            "pert",
            "triangular",
            "uniform",
            "lognormal"
          ],
          "title": "Type",
          "type": "string"
        },
        "low": {
          "title": "Low",
          "type": "number"
        },
        "mode": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mode"
        },
        "high": {
          "title": "High",
          "type": "number"
        }
      },
      "required": [
        "type",
        "low",
        "high"
      ],
      "title": "Dist",
      "type": "object"
    },
    "Grade": {
      "description": "Evidence grade, A (strongest) to D (weakest).",
      "enum": [
        "A",
        "B",
        "C",
        "D"
      ],
      "title": "Grade",
      "type": "string"
    },
    "LabTest": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "measures": {
          "items": {
            "type": "string"
          },
          "title": "Measures",
          "type": "array"
        },
        "method": {
          "title": "Method",
          "type": "string"
        },
        "cost_inr": {
          "$ref": "#/$defs/Param"
        },
        "turnaround_days": {
          "$ref": "#/$defs/Param"
        },
        "cv": {
          "$ref": "#/$defs/Param"
        },
        "replicates_min": {
          "default": 3,
          "title": "Replicates Min",
          "type": "integer"
        },
        "sensitivity": {
          "anyOf": [
            {
              "$ref": "#/$defs/Param"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "specificity": {
          "anyOf": [
            {
              "$ref": "#/$defs/Param"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        }
      },
      "required": [
        "id",
        "name",
        "measures",
        "method",
        "cost_inr",
        "turnaround_days",
        "cv"
      ],
      "title": "LabTest",
      "type": "object"
    },
    "Param": {
      "additionalProperties": false,
      "description": "One input parameter: a point value or a distribution, with provenance.\n\nBoth `value` and `dist` may be missing (null); that means \"no data yet\" and\nthe row must appear in DATA_TODO.md (source plan \u00a711.1). The data files use\nthe source plan's names `evidence_grade` / `applicability`; both spellings load.",
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "dist": {
          "anyOf": [
            {
              "$ref": "#/$defs/Dist"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "tag": {
          "$ref": "#/$defs/Tag"
        },
        "evidence_grade": {
          "anyOf": [
            {
              "$ref": "#/$defs/Grade"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "source_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Id"
        },
        "applicability": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Applicability"
        },
        "conditions": {
          "anyOf": [
            {
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "integer"
                  },
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Conditions"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        },
        "verification_status": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Verification Status"
        },
        "basis": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Basis"
        },
        "method": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Method"
        },
        "material_form": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Material Form"
        },
        "extraction_route": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Extraction Route"
        },
        "source_location": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Location"
        }
      },
      "required": [
        "unit",
        "tag"
      ],
      "title": "Param",
      "type": "object"
    },
    "Tag": {
      "description": "Where a number came from.",
      "enum": [
        "measured",
        "published",
        "assumed",
        "synthetic"
      ],
      "title": "Tag",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "tests": {
      "items": {
        "$ref": "#/$defs/LabTest"
      },
      "title": "Tests",
      "type": "array"
    }
  },
  "required": [
    "tests"
  ],
  "title": "LabTestsFile",
  "type": "object"
}
